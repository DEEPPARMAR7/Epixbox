apiVersion: v1
kind: Secret
metadata:
  name: epixbox-secrets
  namespace: epixbox
type: Opaque
stringData:
  DB_HOST: "your-neon-host"
  DB_PORT: "5432"
  DB_NAME: "neondb"
  DB_USER: "your-neon-user"
  DB_PASSWORD: "replace-with-your-neon-password"
  DB_SSL: "true"
  JWT_ACCESS_SECRET: "replace-with-a-local-access-secret"
  JWT_REFRESH_SECRET: "replace-with-a-local-refresh-secret"
